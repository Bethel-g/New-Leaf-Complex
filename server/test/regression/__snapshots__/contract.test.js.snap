exports[`Contract: multimedia > GET /api/multimedia/capabilities is a static UI manifest > multimedia-capabilities 1`] = `
{
  "body": {
    "integration": {
      "description": "Local development integration that simulates a media player. Reports play/stop as supported; power, volume and mute are not supported and are never reported as success.",
      "id": "mock-local-player",
      "name": "Mock Local Player Integration",
      "not_supported_hint": "power,volume,mute,reboot,input_source",
      "supported_commands": [
        "play",
        "stop",
      ],
    },
    "phase2_limitations": [
      "Emergency broadcast scenarioses handled in a later phase",
      "Advanced device commands (power, volume, mute, reboot) are not supported by the current integration",
      "Remote power management is not implemented",
      "Analytics and reporting dashboard is out of scope for this phase",
    ],
    "repeat_types": [
      "none",
      "daily",
      "weekly",
      "specific_days",
    ],
    "supported_command_manifest": [
      "play",
      "stop",
    ],
    "supported_file_types": {
      "image/jpeg": "jpg",
      "image/png": "png",
      "image/webp": "webp",
      "video/mp4": "mp4",
      "video/webm": "webm",
    },
    "supported_statuses": [
      "online",
      "offline",
      "playing",
      "idle",
      "error",
      "disabled",
    ],
    "target_types": [
      "device",
      "group",
      "all",
    ],
  },
  "status": 200,
}
`;

