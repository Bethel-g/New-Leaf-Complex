{
  "name": "newleaf-server",
  "version": "1.0.0",
  "description": "New Leaf Medical Complex - Operations Request System Backend",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "seed": "knex seed:run",
    "migrate:fresh": "knex migrate:rollback --all && knex migrate:latest && knex seed:run",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:regression": "vitest run test/regression",
    "test:regression:update": "vitest run test/regression -u",
    "test:setup": "knex migrate:rollback --all --env test && knex migrate:latest --env test && knex seed:run --env test"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-validator": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "supertest": "^7.2.2",
    "vitest": "^5.0.1"
  }
}
